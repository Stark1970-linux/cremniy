/* Этот файл заменяет dark.qss. Он НЕ содержит цветов темы напрямую -
 * вместо хексов используются палитровые функции Qt (palette(...)),
 * поэтому смена активной QPalette (см. ThemeManager) сразу перекрашивает
 * весь интерфейс без перегенерации этого файла.
 *
 * Немногочисленные литеральные цвета ниже (#F44747 - red, #4EC9B0-подобные
 * статусные акценты через свойство state) - это семантические
 * статус-цвета (ошибка/успех), они не являются частью темы оформления.
 */

QWidget {
    background-color: palette(window);
    color: palette(window-text);
}

QHexView {
    background-color: palette(base);
    border: none;
}

QPushButton {
    background-color: palette(button);
    border: 1px solid palette(mid);
    color: palette(button-text);
}

QPushButton:hover {
    background-color: palette(highlight);
    border: 1px solid palette(highlight);
}

QPushButton:pressed {
    background-color: palette(highlight);
    border: 2px solid palette(highlight);
    font-weight: bold;
}

QComboBox {
    background-color: palette(button);
    border: 1px solid palette(mid);
}

QComboBox:hover {
    background-color: palette(highlight);
    border: 1px solid palette(highlight);
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: palette(base);
    border: 1px solid palette(mid);
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QPlainTextEdit {
    background-color: palette(base);
}

QLineEdit:hover {
    background-color: palette(highlight);
    border: 1px solid palette(highlight);
}

QListView, QTreeView, QTableView {
    background-color: palette(base);
    border: 1px solid palette(window);
    alternate-background-color: palette(alternate-base);
}

QTabWidget::pane {
    border: 1px solid palette(window);
}

#filesTabWidget QTabBar::close-button {
    image: url(:/icons/close.svg);
}

#filesTabWidget QTabBar::close-button:hover {
    image: url(:/icons/close.svg);
}

#filesTabWidget QTabBar::tab {
    background: palette(window);
    border: 1px solid palette(mid);
}

#filesTabWidget QTabBar::tab:selected {
    background: palette(base);
    border-bottom: 2px solid palette(highlight);
    border-radius: 2px;
}

#filesTabWidget QTabBar::tab:hover:!selected  {
    background-color: palette(alternate-base);
}

#toolTabWidget QTabBar::tab {
    padding: 5px;
    height: 20px;
    min-width: 100px;
    max-width: 200px;
}

#toolTabWidget QTabBar::tab:selected {
    background: palette(base);
    border-top: 2px solid palette(highlight);
    border-radius: 2px;
}

#toolTabWidget QTabBar::tab:hover:!selected  {
    background-color: palette(alternate-base);
}

QListWidget#hexTabsList {
    background: palette(base);
    border: none;
}

QListWidget#hexTabsList::item {
    background: palette(window);
    border-radius: 4px;
}

QListWidget#hexTabsList::item:hover {
    background: palette(alternate-base);
}

QListWidget#hexTabsList::item:selected {
    background: palette(window);
    border-right: 2px solid palette(highlight);
    color: palette(window-text);
}

#hexViewTab QWidget {
    background: palette(base);
}

QTreeView::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}

QTreeView::item:hover:!selected {
    background-color: palette(alternate-base);
}


QMenuBar::item {
    background: transparent;
    color: palette(window-text);
}

QMenuBar::item:selected {
    background-color: palette(mid);
}

QMenuBar::item:hover {
    background-color: palette(mid);
}

QMenu {
    border: 1px solid palette(mid);
    background-color: palette(window);
}

QMenu::item:selected {
    background: palette(highlight);
    color: palette(highlighted-text);
}

QMenu::indicator {
    border-radius: 2px;
    border: 1px solid palette(mid);
}

QMenu::indicator:checked {
    background-color: palette(highlight);
}

QMenu::indicator:unchecked {
    background-color: palette(window);
}


QPushButton[state="green"] {
    border: 1px solid #4EC9B0;
}
QPushButton::hover[state="green"] {
    background-color: #1A3A2A; border: 1px solid #4EC9B0;
}
QPushButton::pressed[state="green"] {
    background-color: #1A3A2A; border: 2px solid #4EC9B0; font-weight: bold;
}

QPushButton[state="red"] {
    border: 1px solid #F44747;
}
QPushButton::hover[state="red"] {
    background-color: #3A1A1A;
    border: 1px solid #F44747;
}
QPushButton::pressed[state="red"] {
    background-color: #3A1A1A;
    border: 2px solid #F44747;
    font-weight: bold;
}

/* Vertical QScrollBar */

QScrollBar:vertical {
    background: palette(base);
}

QScrollBar::handle:vertical {
    background: palette(mid);
    border: 1px solid palette(window);
    border-radius: 2px;
}

QScrollBar::handle:vertical:hover {
    background: palette(dark);
    border: 1px solid palette(window);
    border-radius: 2px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: palette(base);
}

QScrollBar::handle:horizontal {
    background: palette(mid);
    border: 1px solid palette(window);
    border-radius: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: palette(dark);
    border: 1px solid palette(window);
    border-radius: 2px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none;
}

QScrollBar::groove:vertical {
    background: palette(base);
}

QScrollBar::groove:horizontal {
    background: palette(base);
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: palette(base);
}

QWidget#searchPanel {
    background-color: palette(window);
    border-left: 1px solid palette(mid);
}

QWidget#searchPanel QLineEdit,
QWidget#searchPanel QComboBox {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 3px;
}

QWidget#searchPanel QLineEdit:focus,
QWidget#searchPanel QComboBox:focus {
    border: 1px solid palette(highlight);
}

QWidget#searchPanel QLineEdit[state="error"] {
    background-color: #3A1A1A;
    border: 1px solid #F44747;
}

QWidget#searchPanel QPushButton,
QWidget#searchPanel QToolButton {
    background-color: palette(alternate-base);
    color: palette(window-text);
    border: 1px solid palette(mid);
    border-radius: 3px;
}

QWidget#searchPanel QPushButton:hover,
QWidget#searchPanel QToolButton:hover {
    background-color: palette(highlight);
    border: 1px solid palette(highlight);
}

QWidget#searchPanel QPushButton:pressed,
QWidget#searchPanel QToolButton:pressed,
QWidget#searchPanel QToolButton:checked {
    background-color: palette(highlight);
    border: 1px solid palette(highlight);
}

QWidget#searchPanel QPushButton:focus,
QWidget#searchPanel QToolButton:focus,
QWidget#searchPanel QTreeWidget:focus {
    border: 1px solid palette(highlight);
}

QWidget#searchPanel QLabel#searchEmptyDetail,
QWidget#searchPanel QLabel#searchStatusLabel {
    color: palette(placeholder-text);
}

QWidget#searchPanel QLabel#searchStatusLabel[statusState="error"] {
    color: #F48771;
}

QWidget#searchPanel QLabel#searchStatusLabel[statusState="warning"] {
    color: #DCDCAA;
}

QWidget#searchPanel QTreeWidget#searchResultsTree {
    border: 1px solid palette(mid);
    border-radius: 3px;
}

QDialog#settingsDialog QLabel#settingsDialogTitle {
    color: palette(window-text);
    font-size: 20px;
    font-weight: 600;
}

QDialog#settingsDialog QLabel#settingsHintLabel {
    color: palette(placeholder-text);
}

QDialog#settingsDialog QFrame#settingsFooter {
    background: palette(window);
}

QDialog#settingsDialog QWidget#settingsHeader {
    border-bottom: 1px solid palette(mid);
}

QDialog#settingsDialog QFrame#settingsNavigation {
    border: none;
    border-right: 1px solid palette(mid);
}

QDialog#settingsDialog QFrame#settingsPageArea {
    border: none;
}

QDialog#settingsDialog QLabel#settingsNavigationTitle {
    color: palette(placeholder-text);
    font-size: 11px;
    font-weight: bold;
    padding-left: 8px;
}

QDialog#settingsDialog QLabel#settingsPageTitle {
    color: palette(window-text);
    font-size: 16px;
    font-weight: 600;
}

QDialog#settingsDialog QFrame#settingsPageSeparator,
QDialog#settingsDialog QFrame#settingsFooter {
    border: none;
    border-top: 1px solid palette(mid);
}

QDialog#settingsDialog QTreeWidget#settingsCategories {
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
    show-decoration-selected: 0;
}

QDialog#settingsDialog QTreeWidget#settingsCategories::item {
    border-radius: 4px;
    padding: 7px 8px;
}

QDialog#settingsDialog QTreeWidget#settingsCategories::branch {
    background: transparent;
}

QDialog#settingsDialog QTreeWidget#settingsCategories::item:selected {
    background: palette(highlight);
    color: palette(highlighted-text);
}

QDialog#settingsDialog QTreeWidget#settingsCategories::item:hover:!selected {
    background: palette(alternate-base);
}

QDialog#settingsDialog QPushButton#settingsSecondaryButton {
    color: palette(window-text);
    background: transparent;
    border: 1px solid transparent;
}

QDialog#settingsDialog QPushButton#settingsSecondaryButton:hover {
    background: palette(alternate-base);
    border-color: palette(mid);
}

QDialog#settingsDialog QPushButton#settingsAcceptButton {
    min-width: 88px;
}

QDialog#settingsDialog QDialogButtonBox#settingsButtonBox {
    background: transparent;
}

QDialog#settingsDialog QLabel#settingsStatusLabel[statusState="ok"] {
    color: #4EC9B0;
}

QDialog#settingsDialog QLabel#settingsStatusLabel[statusState="missing"] {
    color: #F44747;
}

/* --- Appearance / theme picker & palette editor --- */

QFrame#themeSwatchCard {
    background: palette(base);
    border: 1px solid palette(mid);
    border-radius: 6px;
}

QFrame#themeSwatchCard[selected="true"] {
    border: 2px solid palette(highlight);
}

QFrame#themeSwatchPreview {
    border-radius: 4px;
}

QToolButton#paletteColorSwatch {
    border: 1px solid palette(mid);
    border-radius: 4px;
    min-width: 48px;
    min-height: 24px;
}
