
QWidget {
    font-family: "Segoe UI", "Consolas", monospace;
    font-size: 12px;
}

QHexView {
    font-family: "Consolas", monospace;
    font-size: 16px;
}

QPushButton {
    padding: 6px 12px;
}

QComboBox {
    padding: 2px;
}

QComboBox::drop-down {
    border: 0px;
    width: 0px;
}

QComboBox::down-arrow {
    image: none;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    padding: 2px;
}

#filesTabWidget QTabBar::close-button {
    subcontrol-position: right;
    padding: 2px;
}

#filesTabWidget QTabBar::close-button:hover {
    padding: 1px;
}

#filesTabWidget QTabBar::tab {
    padding: 5px;
    height: 16px;
    min-width: 200px;
}

#toolTabWidget QTabBar::tab {
    padding: 5px;
    height: 20px;
    min-width: 100px;
    max-width: 200px;
}

#toolTabWidget QTabBar::tab:selected {
    height: 20px;
}

QListWidget#hexTabsList {
    min-width: 120px;
    max-width: 200px;
    font-size: 12px;
    padding-top: 5px;
    padding-bottom: 5px;
}

QListWidget#hexTabsList::item {
    padding: 6px;
    margin: 4px;
    outline: none;
}

QListWidget#hexTabsList::item:selected {
    outline: none;
}

QListWidget#hexTabsList::item:focus {
    outline: none;
}

QTreeView {

}

QMenu::item {
    padding: 4px 20px 4px 4px;
}

QMenu::indicator {
    width: 12px;
    height: 12px;
    margin-left: 5px;
    margin-right: 5px;
}

/* Vertical QScrollBar */

QScrollBar:vertical {
    width: 16px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 16px;
}

/* Horizontal QScrollBar */

QScrollBar:horizontal {
    height: 16px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 16px;
}

QWidget#searchPanel QLineEdit {
    padding: 5px 7px;
    min-height: 18px;
}

QWidget#searchPanel QPushButton {
    padding: 5px 10px;
    min-height: 18px;
}

QWidget#searchPanel QComboBox {
    padding: 5px 24px 5px 7px;
    min-height: 18px;
}

QWidget#searchPanel QComboBox::drop-down {
    width: 20px;
}

QWidget#searchPanel QComboBox::down-arrow {
    image: url(:/icons/welcome-caret-down.svg);
    width: 10px;
    height: 10px;
}

QWidget#searchPanel QToolButton {
    padding: 4px;
}

QWidget#searchPanel QLabel#searchEmptyTitle {
    font-weight: bold;
    font-size: 13px;
}

QWidget#searchPanel QLabel#searchStatusLabel {
    font-size: 11px;
}

QLabel#settingsHintLabel {
    font-size: 11px;
}
