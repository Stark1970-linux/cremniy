WelcomeForm {
    background: palette(window);
}

#CardsScrollArea,
#CardsScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: palette(base);
    width: 5px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: palette(dark);
    border-radius: 2px;
    min-height: 24px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

#ProjectCard {
    background: palette(base);
    border-bottom: 1px solid palette(mid);
}

#ProjectCard:hover {
    background: palette(alternate-base);
}

#ProjectCardBadge {
    background: palette(dark);
    color: palette(button-text);
    font-weight: bold;
    font-size: 10px;
    border-radius: 5px;
}

#ProjectCardName {
    color: palette(window-text);
    font-size: 13px;
    font-weight: 600;
}

#ProjectCardPath {
    color: palette(placeholder-text);
    font-size: 11px;
}

#ProjectCardLastOpened {
    color: palette(placeholder-text);
    font-size: 10px;
}

#WelcomeToolbar {
    background: palette(window);
    border-top: 1px solid palette(mid);
}

#CreateProjectPage {
    background: palette(window);
}

#CreateProjectTitle {
    color: palette(window-text);
    font-size: 16px;
    font-weight: bold;
}

#CreateProjectPage QLabel {
    color: palette(placeholder-text);
    font-size: 12px;
}

#CreateProjectPage QLabel[error="true"] {
    color: #cf4444;
}

#CreateProjectPage QLineEdit,
#CreateProjectPage QComboBox {
    background: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 4px;
    padding: 5px 8px;
    font-size: 12px;
}

#CreateProjectPage QLineEdit:focus,
#CreateProjectPage QComboBox:focus {
    border-color: palette(highlight);
}

#CreateProjectPage QComboBox::drop-down {
    border: none;
}

#CreateProjectInfoLabel {
    color: #cf4444;
    font-size: 12px;
    font-weight: bold;
}
